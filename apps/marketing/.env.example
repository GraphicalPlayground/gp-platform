# This is an example environment file for the admin app.
# Copy this file to .env and fill in the required values.

NEXT_PUBLIC_APP_ENV="production,preview,development"
NEXT_PUBLIC_CDN_URL="<cdn-url>"
ALLOWED_DEV_ORIGINS="192.168.1.33,192.168.1.34,localhost"

# Clerk
NEXT_PUBLIC_CLERK_IS_SATELLITE="false"
NEXT_PUBLIC_CLERK_DOMAIN="graphical-playground.com"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="https://graphical-playground.com/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="https://graphical-playground.com/sign-up"
NEXT_PUBLIC_CLERK_WAITLIST_URL="https://graphical-playground.com/waitlist"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_WAITLIST_MODE="true"
