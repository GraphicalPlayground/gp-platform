# This is an example environment file for the admin app.
# Copy this file to .env and fill in the required values.

NEXT_PUBLIC_APP_ENV="production,preview,development"
NEXT_PUBLIC_CDN_URL="<cdn-url>"
ALLOWED_DEV_ORIGINS="192.168.1.33,192.168.1.34,localhost"

# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_WAITLIST_URL=/waitlist
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_WAITLIST_FALLBACK_REDIRECT_URL=/

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_WAITLIST_MODE=true
