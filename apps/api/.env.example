# Server
PORT=3001
NODE_ENV=development

# Database
# Local: postgres://gp_user:gp_password@localhost:5432/gp_platform
# Supabase: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://gp_user:gp_password@localhost:5432/gp_platform

# Auth — generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
