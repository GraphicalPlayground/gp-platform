{
  "name": "gp-platform",
  "folders": [
    { "path": "." }
  ],
  "settings": {
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "material-icon-theme.folders.associations": {
      "standard": "coverage",
      "tsconfig": "typescript",
      "marketing": "cart",
      "logger": "log",
      "certificates": "features",
      "payments": "cart",
      "realtime": "job",
      "certifications": "features",
      "engines": "command",
      "submissions": "archive",
      "subscriptions": "cart",
      "users": "client",
      "legal": "policy",
      "seo": "global",
      "playwright": "test",
      "jsonld": "json",
      "og": "images",
      "engine": "bicep",
      "breakdowns": "assembly",
      "comparisons": "ci",
      "glossary": "enum",
      "guides": "docs",
      "interviews": "java",
      "tech-articles": "template",
      "roadmaps": "context",
      "changelogs": "update",
      "research": "debug",
      "showcases": "bicep",
      "[slug]": "template",
      "[...slug]": "template",
      "default": "base",

      /* Fonts */
      "HubotSans": "font",
      "MonaSans": "font",

      /* Components */
      "Text": "log"
    },
    "material-icon-theme.files.associations": {
      "eslint/base.mjs": "eslint",
      "eslint/next.mjs": "eslint",
      "eslint/react.mjs": "eslint",
      "eslint/node.mjs": "eslint",
      "tsconfig/base.json": "tsconfig",
      "tsconfig/next.json": "tsconfig",
      "tsconfig/node.json": "tsconfig",
      "tsconfig/react.json": "tsconfig",
      "tsconfig/vite.json": "tsconfig",
      "pull_request_template.md": "git",
      "LICENSE_HEADER": "license",
      "DONORS.md": "github-sponsors",
      "app/robots.ts": "dependabot",
      "app/sitemap.ts": "routing",
      "app/manifest.ts": "contributing",
      "layout.tsx": "roadmap"
    }
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "DavidAnson.vscode-markdownlint",
      "hex-ci.stylelint-plus",
      "ZixuanChen.vitest-explorer",
      "unifiedjs.vscode-mdx",
      "midudev.better-svg",
      "yzhang.markdown-all-in-one",
      "PKief.material-icon-theme",
      "redhat.vscode-yaml"
    ],
    "unwantedRecommendations": []
  }
